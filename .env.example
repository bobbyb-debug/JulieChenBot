# Copy this file to .env and add your private values locally or in your host.
DISCORD_TOKEN=
GEMINI_API_KEY=

# Primary AI provider for /chat and recap generation (services/ai_service.py
# tries Groq first, falling back to Gemini above). Previously used in code
# but missing from this file.
GROQ_API_KEY=

# Optional: resolves (IMG)-tagged Joker's Updates post images via Imgur's
# public read API (production/imgur.py). Left unset, image posts fall back
# to text-only -- nothing else is affected. Previously used in code but
# missing from this file.
IMGUR_CLIENT_ID=

# Discord IDs
GUILD_ID=
LIVE_UPDATES_CHANNEL=
PRODUCTION_CHANNEL=
HOUSE_STATUS_CHANNEL=
PRODUCTION_LOG_CHANNEL=

# Discord role ID trusted to run /teach batch and /teach update without
# full server administrator (commands/teach.py). Leave unset to require
# full administrator for those two commands.
TRUSTED_MODERATOR_ROLE_ID=

# Store RSS state, chat history, and logs in one location. Set this to the
# Railway volume mount path after attaching the volume.
STATE_DIR=

# Keep false for chat-only testing. Enable only on the deployed production bot.
ENABLE_SCHEDULER=false

# Admin API (Julie ChenBot Admin Dashboard integration). Off by default.
# Set ADMIN_API_KEY to a long random secret before enabling -- the
# server refuses to start without one. The dashboard's backend sends
# this as "Authorization: Bearer <key>"; it must never be exposed to a
# browser. See admin_api/ and docs/admin_api.md.
ENABLE_ADMIN_API=false
ADMIN_API_PORT=8080
ADMIN_API_KEY=
